# Valores públicos incorporados pelo Vite ao build. Nunca incluir segredos aqui.
# Mesma máquina: não usar localhost no tablet para acessar o computador do backend.
VITE_API_BASE_URL=http://localhost:8080

# Alternativas ilustrativas (ativar apenas uma):
# VITE_API_BASE_URL=http://192.168.1.100:8080
# VITE_API_BASE_URL=https://api.exemplo.com
# VITE_API_BASE_URL=/api
# O caminho relativo exige proxy externo configurado; o Vite deste projeto não o fornece.

# Compatibilidade antiga, SOMENTE em npm run dev e sem VITE_API_BASE_URL:
# VITE_BACKEND_IP=localhost
